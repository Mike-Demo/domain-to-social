              "match": {
                "type": "contains",
                "value": "x-www-form-urlencoded"
              },
              "inclusive": true,
              "parameter": "server.CONTENT_TYPE"
            },
            {
              "match": {
                "type": "regex",
                "value": "/\\b(?:https?|wss?):\\/\\/[^\\/?#\\s@\"'<>\\\\&]{0,8192}@[^\\/?#\\s@\"'<>\\\\&]{0,8192}@/i"
              },
              "inclusive": true,
              "mutations": [
                "urldecode"
              ],
              "parameter": "raw"
            }
          ],
          "parameter": "rules"
        },
        {
          "match": {
            "type": "regex",
            "value": "/\\b(?:https?|wss?):\\/\\/[^\\/?#\\s@\"'<>\\\\]{0,8192}@[^\\/?#\\s@\"'<>\\\\]{0,8192}@/i"
          },
          "parameter": "get.*"
        }
      ],
      "source_revision": "sha256:cd143f1db6da24ad44db3acdfc1c7066",
      "phase": "request",
      "action": "block",
