    {
      "id": 23180,
      "title": "Hono csrf() bypass via hyperlink-auditing text/ping requests (GHSA-46wx-v44x-9hh2)",
      "rule_v2": [
        {
          "rules": [
            {
              "match": {
                "type": "regex",
                "value": "/^\\s{0,16}text\\/ping\\b/i"
              },
              "inclusive": true,
              "parameter": "server.HTTP_CONTENT_TYPE"
            },
            {
              "match": {
                "type": "in_array",
                "value": [
                  "cross-site",
                  "same-site"
                ]
              },
              "inclusive": true,
              "parameter": "server.HTTP_SEC_FETCH_SITE"
            }
          ],
          "parameter": "rules"
        },
        {
          "rules": [
            {
              "match": {
                "type": "regex",
                "value": "/^\\s{0,16}text\\/ping\\b/i"
              },
              "inclusive": true,
              "parameter": "server.HTTP_CONTENT_TYPE"
            },
            {
              "match": {
                "type": "cross_origin"
              },
              "inclusive": true
            }
          ],
          "parameter": "rules"
        }
      ],
