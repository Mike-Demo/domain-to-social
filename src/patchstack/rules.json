    {
      "id": 22470,
      "title": "npm: qs : qs.stringify with arrayFormat 'comma' throws an uncaught TypeError on array elements carrying a non-callable own toString (DoS)",
      "rule_v2": [
        {
          "rules": [
            {
              "match": {
                "type": "contains",
                "value": "json"
              },
              "inclusive": true,
              "parameter": "server.CONTENT_TYPE"
            },
            {
              "match": {
                "type": "regex",
                "value": "/[{,]\\s{0,64}\"toString\"\\s{0,64}:/"
              },
              "inclusive": true,
              "parameter": "raw"
            }
          ],
          "parameter": "rules"
        },
        {
          "match": {
            "type": "regex",
            "value": "/[{,]\"toString\":/"
          },
          "mutations": [
            "json_decode",
            "json_encode"
          ],
          "parameter": "raw"
        },
        {
          "match": {
            "type": "regex",
            "value": "/\\[toString\\]/"
          },
          "parameter": "server.REQUEST_URI"
        },
        {
          "rules": [
            {
              "match": {
                "type": "contains",
                "value": "x-www-form-urlencoded"
              },
              "inclusive": true,
              "parameter": "server.CONTENT_TYPE"
            },
            {
              "match": {
                "type": "regex",
                "value": "/\\[toString\\]/"
              },
              "inclusive": true,
              "mutations": [
                "urldecode"
              ],
              "parameter": "raw"
            }
          ],
          "parameter": "rules"
        }
      ],
      "source_revision": "sha256:c3163ae699648fa36334e47c0066564d",
      "phase": "request",
      "action": "block",
      "category": "denial-of-service"
    },
